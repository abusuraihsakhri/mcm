# Storage backend: sqlite (default) | postgres (not implemented in V1)
MCM_STORAGE_BACKEND=sqlite
MCM_SQLITE_PATH=./mcm.db

# Embedding provider for the vector projection (spec section 22).
# hashed[:dimension]  - offline feature hashing, the default
# sentence-transformers[:model] - needs `pip install -e ".[embeddings]"`
MCM_EMBEDDING_PROVIDER=hashed

# Optional safety boundary for the REST ingestion endpoint.
# Use semicolons between roots. Leave unset for unrestricted local ingestion.
# MCM_ALLOWED_INGEST_ROOTS=/path/to/repositories;/another/allowed/root
